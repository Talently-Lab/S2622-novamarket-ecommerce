# Puerto donde corre la API (Render lo inyecta solo en producción)
PORT=3000

# Cadena de conexión a MongoDB Atlas
# Ej: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/novamarket
MONGODB_URI=

# Clave secreta para firmar los JWT (usar un string largo y aleatorio)
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma, sin "/" al final
# Local:       http://localhost:5173
# Producción:  https://nova-market-s2622.netlify.app
CORS_ORIGIN=http://localhost:5173
